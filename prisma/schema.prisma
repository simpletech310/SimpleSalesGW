  requesterUserId String                @map("requester_user_id") @db.Uuid
  approverUserId  String?               @map("approver_user_id") @db.Uuid
  // MRR sticker + proposed (legacy field names retained for back-compat).
  stickerPrice    Decimal               @map("sticker_price") @db.Decimal(12, 2)
  proposedPrice   Decimal               @map("proposed_price") @db.Decimal(12, 2)
  // One-time onboarding fee sticker + proposed (nullable for legacy rows).
  stickerOneTime  Decimal?              @map("sticker_one_time") @db.Decimal(12, 2)
  proposedOneTime Decimal?              @map("proposed_one_time") @db.Decimal(12, 2)
