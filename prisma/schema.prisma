// SALES PLAYBOOK (v2.2)
// ============================================================================

enum QualificationVerdict {
  LIGHTHOUSE // 80+ — strategic fit, fast-track
  STRONG_FIT // 60-79 — pursue
  MARGINAL // 40-59 — pursue with caution
  REFER // 20-39 — refer to partner / referral network
  DECLINE // <20 — politely decline
}

model QualificationScorecard {
  id               String                @id @default(uuid()) @db.Uuid
  leadId           String                @unique @map("lead_id") @db.Uuid
  industryFit      Int                   @default(0) @map("industry_fit") // 0-15
  sizeFit          Int                   @default(0) @map("size_fit") // 0-15
  geography        Int                   @default(0) // 0-10
  growthPosture    Int                   @default(0) @map("growth_posture") // 0-10
  authority        Int                   @default(0) // 0-15
  budget           Int                   @default(0) // 0-15
  timeline         Int                   @default(0) // 0-10
  complianceDriver Int                   @default(0) @map("compliance_driver") // 0-10
  total            Int                   @default(0)
  verdict          QualificationVerdict?
  reasonCodes      String[]              @default([]) @map("reason_codes")
  notes            String?               @db.Text
  scoredByUserId   String?               @map("scored_by_user_id") @db.Uuid
  scoredAt         DateTime?             @map("scored_at")
  createdAt        DateTime              @default(now()) @map("created_at")
  updatedAt        DateTime              @updatedAt @map("updated_at")

  lead     Lead  @relation(fields: [leadId], references: [id], onDelete: Cascade)
  scoredBy User? @relation("QualificationScorer", fields: [scoredByUserId], references: [id])

  @@index([verdict])
  @@map("qualification_scorecards")
}

model DiscoveryCallNote {
  id                String    @id @default(uuid()) @db.Uuid
  leadId            String    @map("lead_id") @db.Uuid
  conductedAt       DateTime  @map("conducted_at")
  conductedByUserId String    @map("conducted_by_user_id") @db.Uuid
  durationMinutes   Int?      @map("duration_minutes")
  // 6-section structured notes per 02_Discovery_Call_Script
  openingNotes      String?   @map("opening_notes") @db.Text
  businessNotes     String?   @map("business_notes") @db.Text
  techNotes         String?   @map("tech_notes") @db.Text
  decisionNotes     String?   @map("decision_notes") @db.Text
  miniPitchNotes    String?   @map("mini_pitch_notes") @db.Text
  closeNotes        String?   @map("close_notes") @db.Text
  // Outputs
  nextStep          String?   @map("next_step")
  nextStepDueAt     DateTime? @map("next_step_due_at")
  commitments       Json      @default("[]") // [{ text, ownerName, dueAt? }]
  redFlags          Json      @default("[]") @map("red_flags") // [{ text, severity }]
  preCallChecklist  Json      @default("{}") @map("pre_call_checklist") // { researchDone, decisionMakerConfirmed, agendaSent, ... }
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  lead        Lead @relation(fields: [leadId], references: [id], onDelete: Cascade)
  conductedBy User @relation("DiscoveryCallConductor", fields: [conductedByUserId], references: [id])

  @@index([leadId, conductedAt])
  @@map("discovery_call_notes")
}

model ObjectionTemplate {
