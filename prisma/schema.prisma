  lead     Lead               @relation(fields: [leadId], references: [id], onDelete: Cascade)
  template ObjectionTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)
  raisedBy User               @relation("ObjectionRaiser", fields: [raisedByUserId], references: [id])

  @@index([leadId, raisedAt])
  @@map("objection_logs")
}

enum OutreachCategory {
  INTRO
  FOLLOW_UP
  POST_ASSESSMENT
  PROPOSAL
  NURTURE
}

model OutreachTemplate {
  id           String           @id @default(uuid()) @db.Uuid
  name         String           @unique
  category     OutreachCategory
  industry     Industry? // optional vertical filter
  trigger      String? // optional trigger event filter
  subject      String
  body         String           @db.Text
  placeholders String[]         @default([]) // auto-detected {{var}} list
  active       Boolean          @default(true)
  createdAt    DateTime         @default(now()) @map("created_at")
  updatedAt    DateTime         @updatedAt @map("updated_at")

  @@index([category])
  @@index([industry])
  @@map("outreach_templates")
}

// ============================================================================
// USER PREFERENCES (v2.4 — per-role onboarding)
// ============================================================================

model UserPreference {
  id             String   @id @default(uuid()) @db.Uuid
  userId         String   @unique @map("user_id") @db.Uuid
  onboardingSeen String[] @default([]) @map("onboarding_seen") // dismissed flow keys
  preferences    Json     @default("{}") // future-proof bag
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_preferences")
}

// ============================================================================
// v2.22 — SALES TEAMS, TERRITORIES, ASSIGNMENT, DAILY.CO CALLS
// ============================================================================

enum TeamRole {
  LEAD // team lead / supervisor
  MEMBER // regular rep
}

model SalesTeam {
  id           String        @id @default(uuid()) @db.Uuid
  name         String        @unique
  description  String?       @db.Text
  // Services this team sells. Drives auto-assignment heuristics + the
  // territory→team match. Empty array = generalist team.
  serviceLines ServiceLine[] @default([]) @map("service_lines")
  active       Boolean       @default(true)
  createdAt    DateTime      @default(now()) @map("created_at")
  updatedAt    DateTime      @updatedAt @map("updated_at")

  members     SalesTeamMember[]
  territories SalesTerritory[]
  leads       Lead[]

  @@map("sales_teams")
}

model SalesTeamMember {
  id        String   @id @default(uuid()) @db.Uuid
  teamId    String   @map("team_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  // v2.22 — reps can belong to multiple teams. `isPrimary` marks the
  // default landing-view team. Exactly one membership per user should
  // be primary (enforced app-level on assign).
  isPrimary Boolean  @default(false) @map("is_primary")
  role      TeamRole @default(MEMBER)
  joinedAt  DateTime @default(now()) @map("joined_at")

  team SalesTeam @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([teamId, userId])
  @@index([userId])
  @@index([teamId])
  @@map("sales_team_members")
}

model SalesTerritory {
  id        String   @id @default(uuid()) @db.Uuid
  name      String
  teamId    String   @map("team_id") @db.Uuid
  // List-based match dimensions. Any hit across these = territory match.
  states    String[] @default([])
  zipCodes  String[] @default([]) @map("zip_codes")
  // Cities as JSON: [{ city: "Burbank", state: "CA" }, ...]
  cities    Json     @default("[]")
  // v2.22 — optional polygon drawn via Mapbox Draw. Shape:
  // { type: "Polygon", coordinates: [[[lng, lat], ...]] } (GeoJSON-style).
  // Server-side point-in-polygon match against Lead.addressLat/Lng.
  polygon   Json?
  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  team  SalesTeam @relation(fields: [teamId], references: [id], onDelete: Cascade)
  leads Lead[]

  @@index([teamId])
  @@map("sales_territories")
}

enum CallSessionStatus {
  ACTIVE
  ENDED
  FAILED
}

model SalesCallSession {
  id              String            @id @default(uuid()) @db.Uuid
  leadId          String            @map("lead_id") @db.Uuid
  initiatorUserId String            @map("initiator_user_id") @db.Uuid
  dailyRoomName   String            @unique @map("daily_room_name")
  dailyRoomUrl    String            @map("daily_room_url")
  // VIDEO_CALL or AUDIO_CALL (mirrors ActivityType for filtering).
  // v2.22 — no @default; call-start API always sets explicitly. The
  // Postgres "can't reference new enum value in same tx" rule made
  // this required (see migration.sql comment).
  kind            ActivityType
  status          CallSessionStatus @default(ACTIVE)
  startedAt       DateTime          @default(now()) @map("started_at")
  endedAt         DateTime?         @map("ended_at")
  durationSeconds Int?              @map("duration_seconds")
  // v2.23 — populated by Daily.co webhook when recording lands
  recordingUrl    String?           @map("recording_url")
  // Linked Activity row so the rep's quick-action feed shows the call
  activityId      String?           @map("activity_id") @db.Uuid
  createdAt       DateTime          @default(now()) @map("created_at")

  lead      Lead @relation(fields: [leadId], references: [id], onDelete: Cascade)
  initiator User @relation("CallInitiator", fields: [initiatorUserId], references: [id])

  @@index([leadId, startedAt])
  @@map("sales_call_sessions")
}

// ============================================================================
// v3.3 — SOP-ALIGNMENT SWEEP (Proposal / SOW, Kickoff, Debrief)
// ============================================================================

// SOP Step 1: structured trigger event capture
enum TriggerEvent {
  NONE
  CYBER_INSURANCE_RENEWAL
  PEER_BREACH
  FEDERAL_CONTRACT_ANNOUNCEMENT
  MA_ACTIVITY
  CUSTOMER_CYBER_QUESTIONNAIRE
  COMPLIANCE_AUDIT
  MSP_DISSATISFACTION
  GROWTH_HIRING
  OTHER
}

// SOP Step 6: proposal lifecycle
enum ProposalStatus {
  DRAFT
  VCIO_REVIEW
  MANAGER_REVIEW
  APPROVED
  SENT
  ACCEPTED
  DECLINED
  SUPERSEDED
}

// Reused by Proposal review gates AND DiscoveryAssessment.vcioVerdict
enum ReviewVerdict {
  APPROVED
  REJECTED
  CHANGES_REQUESTED
}

// Step 6 + admin: a library of SOW templates the rep picks from
model SowTemplate {
  id                   String         @id @default(uuid()) @db.Uuid
  name                 String // "Managed IT — Compliance Plus"
  description          String?        @db.Text
  bundle               ServiceBundle? // null = generalist
  industry             Industry? // optional vertical filter
  version              Int            @default(1)
  active               Boolean        @default(true)
  scopeMarkdown        String         @db.Text // each section is markdown with {{merge_fields}}
  deliverablesMarkdown String         @db.Text
  timelineMarkdown     String         @db.Text
  exclusionsMarkdown   String         @db.Text
  termsMarkdown        String         @db.Text
  createdAt            DateTime       @default(now()) @map("created_at")
  updatedAt            DateTime       @updatedAt @map("updated_at")
  createdByUserId      String?        @map("created_by_user_id") @db.Uuid

  createdBy User?      @relation("SowTemplateCreator", fields: [createdByUserId], references: [id])
  proposals Proposal[]

  @@index([bundle, active])
  @@index([industry, active])
  @@map("sow_templates")
}

// Step 6: a specific Proposal/SOW draft for a specific Lead
model Proposal {
  id                   String         @id @default(uuid()) @db.Uuid
  leadId               String         @map("lead_id") @db.Uuid
  templateId           String?        @map("template_id") @db.Uuid // which SowTemplate seeded the draft
  version              Int            @default(1) // version-on-edit
  status               ProposalStatus @default(DRAFT)
  // Resolved sections (post-merge, editable)
  scopeMarkdown        String         @db.Text
  deliverablesMarkdown String         @db.Text
  timelineMarkdown     String         @db.Text
  exclusionsMarkdown   String         @db.Text
  termsMarkdown        String         @db.Text
  // Snapshot of pricing at the moment of draft so a later catalog change can't silently
  // mutate the artifact the client saw
  pricingSnapshot      Json           @default("{}")
  // Gate sign-offs
  vcioReviewedAt       DateTime?      @map("vcio_reviewed_at")
  vcioReviewedById     String?        @map("vcio_reviewed_by_id") @db.Uuid
  vcioReviewVerdict    ReviewVerdict? @map("vcio_review_verdict")
  vcioReviewNotes      String?        @map("vcio_review_notes") @db.Text
  managerReviewedAt    DateTime?      @map("manager_reviewed_at")
  managerReviewedById  String?        @map("manager_reviewed_by_id") @db.Uuid
  managerReviewVerdict ReviewVerdict? @map("manager_review_verdict")
  managerReviewNotes   String?        @map("manager_review_notes") @db.Text
  // Send / accept
  sentAt               DateTime?      @map("sent_at")
  sentByUserId         String?        @map("sent_by_user_id") @db.Uuid
  pdfBlobUrl           String?        @map("pdf_blob_url")
  acceptedAt           DateTime?      @map("accepted_at")
  declinedAt           DateTime?      @map("declined_at")
  declinedReason       String?        @map("declined_reason") @db.Text
  // SOP Step 7b — redline escalation
  redlineRequestedAt   DateTime?      @map("redline_requested_at")
  redlineRequestReason String?        @map("redline_request_reason") @db.Text
  redlineResolvedAt    DateTime?      @map("redline_resolved_at")
  redlineResolution    String?        @map("redline_resolution") @db.Text
  // AI provenance
  aiDraftedAt          DateTime?      @map("ai_drafted_at")
  aiDraftModel         String?        @map("ai_draft_model")
  aiScopeQcJson        Json?          @map("ai_scope_qc_json") // most-recent SOW_SCOPE_QC output
  aiScopeQcAt          DateTime?      @map("ai_scope_qc_at")
  createdAt            DateTime       @default(now()) @map("created_at")
  updatedAt            DateTime       @updatedAt @map("updated_at")

  lead              Lead         @relation(fields: [leadId], references: [id], onDelete: Cascade)
  template          SowTemplate? @relation(fields: [templateId], references: [id])
  vcioReviewedBy    User?        @relation("ProposalVcioReviewer", fields: [vcioReviewedById], references: [id])
  managerReviewedBy User?        @relation("ProposalManagerReviewer", fields: [managerReviewedById], references: [id])
  sentBy            User?        @relation("ProposalSender", fields: [sentByUserId], references: [id])

  @@index([leadId, version])
  @@index([status])
  @@map("proposals")
}

// SOP Step 9: salesperson kickoff for new customer
model Kickoff {
  id                    String    @id @default(uuid()) @db.Uuid
  customerId            String    @unique @map("customer_id") @db.Uuid
  scheduledAt           DateTime? @map("scheduled_at")
  completedAt           DateTime? @map("completed_at")
  relationshipNarrative String?   @map("relationship_narrative") @db.Text
  decisionMakerRecap    String?   @map("decision_maker_recap") @db.Text
  day30CommitmentRecap  String?   @map("day30_commitment_recap") @db.Text
  salesAttended         Boolean   @default(false) @map("sales_attended")
  vcioAttended          Boolean   @default(false) @map("vcio_attended")
  notes                 String?   @db.Text
  // AI provenance (KICKOFF_NARRATIVE)
  aiDraftedAt           DateTime? @map("ai_drafted_at")
  aiDraftJson           Json?     @map("ai_draft_json")
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@map("kickoffs")
}

// SOP Step 10: post-close debrief
model DealDebrief {
  id                String        @id @default(uuid()) @db.Uuid
  leadId            String        @unique @map("lead_id") @db.Uuid
  outcome           PipelineStage // CLOSED_WON or CLOSED_LOST
  primaryReason     String // free enum: PRICE | SCOPE | TIMING | TRUST | RELATIONSHIP | INCUMBENT | OTHER
  whatWorked        String?       @map("what_worked") @db.Text // CLOSED_WON only
  objectionResolved String?       @map("objection_resolved") @db.Text // CLOSED_WON only
  templateThatWon   String?       @map("template_that_won") // CLOSED_WON only — name of outreach template
  whatBroke         String?       @map("what_broke") @db.Text // CLOSED_LOST only
  playbookUpdate    String?       @map("playbook_update") @db.Text // what to tweak in objections / outreach / scoring
  // AI provenance (DEBRIEF_DRAFT)
  aiSuggestedAt     DateTime?     @map("ai_suggested_at")
  aiSuggestedJson   Json?         @map("ai_suggested_json")
  submittedById     String        @map("submitted_by_id") @db.Uuid
  submittedAt       DateTime      @default(now()) @map("submitted_at")

  lead        Lead @relation(fields: [leadId], references: [id], onDelete: Cascade)
  submittedBy User @relation("DebriefSubmitter", fields: [submittedById], references: [id])

  @@index([outcome])
  @@map("deal_debriefs")
}
