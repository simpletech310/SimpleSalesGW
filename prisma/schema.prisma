model ObjectionLog {
  id             String   @id @default(uuid()) @db.Uuid
  leadId         String   @map("lead_id") @db.Uuid
  templateId     String?  @map("template_id") @db.Uuid
  category       String
  text           String   @db.Text // the actual objection raised
  rebuttalUsed   String?  @map("rebuttal_used") @db.Text
  outcome        String? // e.g. RESOLVED / ESCALATED / OPEN
  raisedByUserId String   @map("raised_by_user_id") @db.Uuid
