// Gateway TelNet Sales Portal — Prisma schema
// Owned by Agent A. All other agents read from this contract.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  // v3.3.19 — Neon (and any pgbouncer transaction-pooler) can't hold the
  // advisory locks Prisma uses to serialize migrations. `directUrl` points
  // at the non-pooled endpoint and is only used by `prisma migrate` /
  // `prisma db push`; runtime queries still go through DATABASE_URL.
  // Falls back to DATABASE_URL when DIRECT_URL isn't set.
  directUrl = env("DIRECT_URL")
}

// ============================================================================
// ENUMS
// ============================================================================

enum Role {
  SALESPERSON
  SALES_MANAGER
  VCIO
  COO
  SUPERADMIN
}

enum Industry {
  MEDICAL
  LEGAL
  FEDERAL_CONTRACTING
  MANUFACTURING
  HOSPITALITY
  FINANCIAL_SERVICES
  PROFESSIONAL_SERVICES
  EDUCATION
  NONPROFIT
  OTHER
}

enum PipelineStage {
  LEAD
  QUALIFIED
  // v3.3.22 — MSP-friendly canonical flow:
  // LEAD → QUALIFIED → FIRST_INTERACTION → SITE_SURVEY_SCHEDULED →
  // DISCOVERY ("Discovery / Engineering") → QUOTE_IN_PROGRESS →
  // QUOTE_SENT → NEGOTIATION → CLOSED_WON / CLOSED_LOST.
  // PRE_SALES + PROPOSAL stay as legacy values so existing leads
  // don't break — new leads use the new flow.
  FIRST_INTERACTION
  SITE_SURVEY_SCHEDULED
  DISCOVERY
  PRE_SALES
  QUOTE_IN_PROGRESS
  QUOTE_SENT
  PROPOSAL
  NEGOTIATION
  CLOSED_WON
  CLOSED_LOST
  NURTURE
}

enum LeadSource {
  INBOUND
  OUTBOUND
  REFERRAL
  EVENT
  PARTNER
  OTHER
}

enum ComplianceDriver {
  HIPAA
  PCI
  CMMC
  FERPA
  GLBA
  NYDFS
  SEC
  FFIEC
  OTHER
  NONE
}

// v2.15 — classifies what kind of deal this is. Drives:
//   - PricingCard form (bundles vs line-item quote builder)
//   - Handoff form context
//   - Which onboarding tasks get materialized at handoff acceptance
//   - vCIO portfolio display of service mix
// MANAGED_IT_BUNDLE is the historical default (pre-v2.15 leads).
enum DealKind {
  MANAGED_IT_BUNDLE
  VOICE_ONLY
  VOICE_PLUS_VIDEO
  STRUCTURED_CABLING_JOB
  ACCESS_CONTROL_PROJECT
  VIDEO_SURVEILLANCE_PROJECT
  CUSTOM_MIX
}

enum RegulatedDataType {
  PHI
  PII
  PCI_DATA
  CUI
  FERPA_DATA
  FINANCIAL
  TRADE_SECRET
  OTHER
  NONE
}

enum MspSatisfaction {
  HAPPY
  NEUTRAL
  LEAVING
  NONE
}

enum ServiceLine {
  MANAGED_IT
  VOIP
  CABLING
  ACCESS_CONTROL
  VIDEO
  CYBERSECURITY
  NIST_ASSESSMENT
  AI_ADVISORY
  VCIO_RETAINER
}

enum ServiceBundle {
  ESSENTIAL
  PROFESSIONAL
  ENTERPRISE
  COMPLIANCE_PLUS
  CUSTOM
}

enum ActivityType {
  CALL
  EMAIL
  MEETING
  NOTE
  STAGE_CHANGE
  SCORE_CHANGE
  RESEARCH
  ASSESSMENT_SENT
  ASSESSMENT_COMPLETED
  PROPOSAL_SENT
  FOLLOW_UP_SCHEDULED
  HANDOFF_INITIATED
  HANDOFF_ACCEPTED
  // v2.22 — engagement quick-actions for SDRs/BDRs
  DOOR_KNOCK
  GATEKEEPER_REJECTED
  MEETING_SET
  NOT_INTERESTED
  // v2.22 — Daily.co call sessions
  VIDEO_CALL
  AUDIO_CALL
}

enum ActivityOutcome {
  POSITIVE
  NEUTRAL
  NEGATIVE
  NO_RESPONSE
}

enum AssessmentMode {
  IN_PERSON
  SELF_SERVICE_LINK
  HYBRID
}

enum AssessmentStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
  EXPIRED
}

enum ResearchArtifactType {
  WEBSITE_SNAPSHOT
  LINKEDIN_LINK
  GOOGLE_BUSINESS_DATA
  NEWS_MENTION
  CLAUDE_SUMMARY
  // v2.20 — cached outputs from the new AI features. Single artifact
  // table; type drives the renderer.
  OBJECTION_REBUTTAL
  DISCOVERY_PREP_BRIEF
  OUTREACH_DRAFT
  PRESALE_NARRATIVE
  HANDOFF_QC
  // v2.23 — vCIO post-assessment recommendations (tasks + services + risks)
  VCIO_RECOMMENDATION
}

// v2.20 — which AI feature spent a Claude call. Drives usage roll-ups + budget caps.
enum AiFeatureKind {
  RESEARCH_SUMMARY
  OBJECTION_REBUTTAL
  DISCOVERY_PREP
  OUTREACH_PERSONALIZE
  PRESALE_NARRATIVE
  HANDOFF_QC
  // v2.22 — per-lead sales coach (next-action recommendation from activity)
  SALES_COACH
  // v2.23 — vCIO post-assessment recommendations (structured task plan)
  VCIO_RECOMMENDATION
  // v3.3 — SOP-alignment sweep: 8 new assistants
  SOW_DRAFT
  SOW_SCOPE_QC
  ASSESSMENT_VERDICT_SUGGEST
  HANDOFF_QUICK_WIN
  HANDOFF_PAIN_RECAP
  TRIGGER_EVENT_DETECT
  KICKOFF_NARRATIVE
  DEBRIEF_DRAFT
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  APPROVE
  REJECT
  LOGIN
  EXPORT
}

enum HandoffStatus {
  DRAFT
  INITIATED
  ACCEPTED
  REJECTED
}

enum PricingApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

// ============================================================================
// v2.0 — post-handoff customer lifecycle
// ============================================================================

enum CustomerStatus {
  ONBOARDING
  ACTIVE
  PAUSED
  CHURNED
}

enum DiscoveryKind {
  SITE_SURVEY
  AI_READINESS
  NIST_CSF
  NIST_800_171
  // v2.17 — lightweight pre-sale scoping banks (~25 Q each), used on
  // Leads before the deal closes. SITE_SURVEY also runs pre-sale.
  VOICE_SCOPING
  CCTV_SCOPING
  ACCESS_CONTROL_SCOPING
}

enum SignedDocType {
  MSA
  SOW
  BAA
  NDA
  DPA
  AMENDMENT
  OTHER
}

enum SignedDocStatus {
  DRAFT
  SENT
  SIGNED
  EXPIRED
  SUPERSEDED
}

enum CircuitType {
  FIBER
  CABLE
  DSL
  MPLS
  WIRELESS
  SATELLITE
  OTHER
}

enum StorageType {
  NAS
  SAN
  DAS
  CLOUD
  OTHER
}

enum LicenseType {
  M365
  GWS
  SAAS
  PERPETUAL
  OTHER
}

enum DiscoveryStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
}

enum OnboardingPhase {
  PRE_ENGAGEMENT
  DISCOVERY
  ONBOARD
  STABILIZE
  STEADY_STATE
}

enum OnboardingTaskStatus {
  PENDING
  IN_PROGRESS
  DONE
  SKIPPED
  BLOCKED
}

// ============================================================================
// AUTH (NextAuth v5 adapter shape)
// ============================================================================

model User {
  id            String    @id @default(uuid()) @db.Uuid
  email         String    @unique
  name          String
  role          Role      @default(SALESPERSON)
  phone         String?
  avatarUrl     String?   @map("avatar_url")
  passwordHash  String?   @map("password_hash") // fallback only; magic-link is primary
  emailVerified DateTime? @map("email_verified")
  image         String?
  active        Boolean   @default(true)
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")
  lastLoginAt   DateTime? @map("last_login_at")

  ownedLeads               Lead[]                   @relation("LeadOwner")
  activities               Activity[]
  notes                    Note[]
  assessments              Assessment[]
  auditLogs                AuditLog[]
  accounts                 Account[]
  sessions                 Session[]
  nonStrategicApprovals    Lead[]                   @relation("NonStrategicApprover")
  handoffsInitiated        Handoff[]                @relation("HandoffInitiator")
  handoffsAccepted         Handoff[]                @relation("HandoffAcceptor")
  attachments              Attachment[]
  pricingRequests          PricingApproval[]        @relation("PricingRequester")
  pricingApprovals         PricingApproval[]        @relation("PricingApprover")
  managedCustomers         Customer[]               @relation("CustomerManager")
  discoveryCreated         DiscoveryAssessment[]    @relation("DiscoveryCreator")
  // v2.23 — vCIO plans this user accepted (materialized into OnboardingTask rows)
  plansAccepted            DiscoveryAssessment[]    @relation("PlanAccepter")
  // v2.20 — Claude calls this user triggered
  aiUsageEvents            AiUsageLog[]             @relation("AiUsageActor")
  onboardingTasks          OnboardingTask[]         @relation("OnboardingTaskOwner")
  signedDocsUploaded       SignedDocument[]         @relation("SignedDocUploader")
  qualificationScores      QualificationScorecard[] @relation("QualificationScorer")
  discoveryCallsConducted  DiscoveryCallNote[]      @relation("DiscoveryCallConductor")
  // v3.3 — SOP-alignment reviewer + creator relations
  sowTemplatesCreated      SowTemplate[]            @relation("SowTemplateCreator")
  proposalsVcioReviewed    Proposal[]               @relation("ProposalVcioReviewer")
  proposalsManagerReviewed Proposal[]               @relation("ProposalManagerReviewer")
  proposalsSent            Proposal[]               @relation("ProposalSender")
  assessmentVcioVerdicts   DiscoveryAssessment[]    @relation("AssessmentVcioVerdict")
  debriefsSubmitted        DealDebrief[]            @relation("DebriefSubmitter")
  // v2.22 — sales team memberships + Daily.co calls initiated
  teamMemberships          SalesTeamMember[]
  callsInitiated           SalesCallSession[]       @relation("CallInitiator")
  objectionsRaised         ObjectionLog[]           @relation("ObjectionRaiser")
  preferences              UserPreference?

  @@map("users")
}

model Account {
  id                String  @id @default(cuid())
  userId            String  @map("user_id") @db.Uuid
  type              String
  provider          String
  providerAccountId String  @map("provider_account_id")
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique @map("session_token")
  userId       String   @map("user_id") @db.Uuid
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

// ============================================================================
// CORE DOMAIN
// ============================================================================

model Lead {
  id                         String              @id @default(uuid()) @db.Uuid
  ownerUserId                String              @map("owner_user_id") @db.Uuid
  businessName               String              @map("business_name")
  dbaName                    String?             @map("dba_name")
  industry                   Industry
  subindustry                String?
  seatCount                  Int?                @map("seat_count")
  siteCount                  Int                 @default(1) @map("site_count")
  addressStreet              String?             @map("address_street")
  addressCity                String?             @map("address_city")
  addressState               String?             @map("address_state")
  addressZip                 String?             @map("address_zip")
  // v2.22 — server-side Mapbox geocode result; powers /leads/map markers
  // and polygon-territory matching. Refreshed when address fields change.
  addressLat                 Decimal?            @map("address_lat") @db.Decimal(10, 7)
  addressLng                 Decimal?            @map("address_lng") @db.Decimal(10, 7)
  geocodedAt                 DateTime?           @map("geocoded_at")
  // v2.22 — sales team + territory ownership (nullable = unassigned).
  // Auto-matched from territories on lead create + address patch; sales
  // manager can override via /sales/assign workbench.
  teamId                     String?             @map("team_id") @db.Uuid
  territoryId                String?             @map("territory_id") @db.Uuid
  websiteUrl                 String?             @map("website_url")
  linkedinCompanyUrl         String?             @map("linkedin_company_url")
  googleBusinessUrl          String?             @map("google_business_url")
  primaryContactName         String?             @map("primary_contact_name")
  primaryContactTitle        String?             @map("primary_contact_title")
  primaryContactEmail        String?             @map("primary_contact_email")
  primaryContactPhone        String?             @map("primary_contact_phone")
  executiveSponsorName       String?             @map("executive_sponsor_name")
  executiveSponsorTitle      String?             @map("executive_sponsor_title")
  pipelineStage              PipelineStage       @default(LEAD) @map("pipeline_stage")
  source                     LeadSource          @default(INBOUND)
  // v2.15 — what's being sold. Drives PricingCard form + onboarding template subset.
  dealKind                   DealKind            @default(MANAGED_IT_BUNDLE) @map("deal_kind")
  // v2.15 — line-item quote for non-bundle deals (extensions / drops / doors / cameras).
  // Shape: { lines: [{ kind, label, qty, perUnitMrr, perUnitOneTime, notes? }] }
  dealLineItems              Json?               @map("deal_line_items")
  cyberInsuranceRenewalDate  DateTime?           @map("cyber_insurance_renewal_date")
  complianceDrivers          ComplianceDriver[]  @map("compliance_drivers")
  regulatedDataTypes         RegulatedDataType[] @map("regulated_data_types")
  currentMspName             String?             @map("current_msp_name")
  currentMspSatisfaction     MspSatisfaction     @default(NONE) @map("current_msp_satisfaction")
  // v3.3.11 — multi-service intake. Reps capture not just IT but voice
  // (VoIP), physical security (access control + video), cabling, and AI
  // advisory signals on first touch so cross-sells aren't an afterthought.
  // interestedServices is the rep's checkbox of "they mentioned this".
  interestedServices         ServiceLine[]       @default([]) @map("interested_services")
  currentPhoneSystem         String?             @map("current_phone_system")
  currentPhonePainPoint      String?             @map("current_phone_pain_point") @db.Text
  currentAccessControl       String?             @map("current_access_control")
  currentAccessDoorCount     Int?                @map("current_access_door_count")
  currentVideoSurveillance   String?             @map("current_video_surveillance")
  currentVideoCameraCount    Int?                @map("current_video_camera_count")
  cablingStatus              String?             @map("cabling_status")
  expansionPlans             String?             @map("expansion_plans") @db.Text
  aiAdvisoryInterest         String?             @map("ai_advisory_interest") @db.Text
  researchSummary            String?             @map("research_summary") @db.Text
  researchCompletedAt        DateTime?           @map("research_completed_at")
  // v3.3.10 — persist the three cards Claude returns on Gather/Summarize so
  // the rep sees them on reload + can edit them inline.
  researchFitSignals         String[]            @default([]) @map("research_fit_signals")
  researchSuggestedQuestions String[]            @default([]) @map("research_suggested_questions")
  researchRisks              String[]            @default([]) @map("research_risks")
  suggestedBundle            ServiceBundle?      @map("suggested_bundle")
  servicesScore              Int                 @default(0) @map("services_score")
  customerScore              Int                 @default(0) @map("customer_score")
  dealQualityScore           Int                 @default(0) @map("deal_quality_score")
  nonStrategicFlag           Boolean             @default(false) @map("non_strategic_flag")
  nonStrategicApprovalUserId String?             @map("non_strategic_approval_user_id") @db.Uuid
  nonStrategicApprovalReason String?             @map("non_strategic_approval_reason") @db.Text
  expectedCloseDate          DateTime?           @map("expected_close_date")
  actualCloseDate            DateTime?           @map("actual_close_date")
  closedLostReason           String?             @map("closed_lost_reason") @db.Text
  connectwiseOpportunityId   String?             @map("connectwise_opportunity_id")
  // v3.3 — SOP Step 1: structured trigger event capture
  triggerEvent               TriggerEvent?       @default(NONE) @map("trigger_event")
  triggerEventNote           String?             @map("trigger_event_note") @db.Text
  // v3.3 — SOP Step 7c: paperwork checklist gate before CLOSED_WON
  paymentMethodOnFile        Boolean             @default(false) @map("payment_method_on_file")
  createdAt                  DateTime            @default(now()) @map("created_at")
  updatedAt                  DateTime            @updatedAt @map("updated_at")

  owner                User                    @relation("LeadOwner", fields: [ownerUserId], references: [id])
  nonStrategicApprover User?                   @relation("NonStrategicApprover", fields: [nonStrategicApprovalUserId], references: [id])
  activities           Activity[]
  notes                Note[]
  assessments          Assessment[]
  serviceMatches       ServiceMatch[]
  researchArtifacts    ResearchArtifact[]
  handoffs             Handoff[]
  attachments          Attachment[]
  pricingApprovals     PricingApproval[]
  customer             Customer?
  signedDocuments      SignedDocument[]
  qualification        QualificationScorecard?
  // v3.3 — SOP Step 6 + Step 10
  proposals            Proposal[]
  debrief              DealDebrief?
  discoveryCallNotes   DiscoveryCallNote[]
  objectionLogs        ObjectionLog[]
  // v2.17 — pre-sale technical scoping (voice / CCTV / access / IT)
  preSaleAssessments   DiscoveryAssessment[]
  // v2.20 — AI usage rows scoped to this lead (for per-lead budget cap)
  aiUsageLogs          AiUsageLog[]
  // v2.22 — sales team + territory + Daily.co call sessions
  team                 SalesTeam?              @relation(fields: [teamId], references: [id], onDelete: SetNull)
  territory            SalesTerritory?         @relation(fields: [territoryId], references: [id], onDelete: SetNull)
  callSessions         SalesCallSession[]

  @@index([ownerUserId])
  @@index([pipelineStage])
  @@index([industry])
  @@index([dealKind])
  @@index([dealQualityScore])
  @@index([expectedCloseDate])
  @@index([teamId])
  @@index([territoryId])
  @@index([triggerEvent])
  @@map("leads")
}

model Activity {
  id                  String           @id @default(uuid()) @db.Uuid
  leadId              String           @map("lead_id") @db.Uuid
  actorUserId         String           @map("actor_user_id") @db.Uuid
  type                ActivityType
  subject             String
  body                String?          @db.Text
  outcome             ActivityOutcome?
  nextAction          String?          @map("next_action")
  nextActionDueAt     DateTime?        @map("next_action_due_at")
  nextActionCompleted Boolean          @default(false) @map("next_action_completed")
  createdAt           DateTime         @default(now()) @map("created_at")

  lead  Lead @relation(fields: [leadId], references: [id], onDelete: Cascade)
  actor User @relation(fields: [actorUserId], references: [id])

  @@index([leadId])
  @@index([nextActionDueAt])
  @@map("activities")
}

model Note {
  id          String   @id @default(uuid()) @db.Uuid
  leadId      String   @map("lead_id") @db.Uuid
  actorUserId String   @map("actor_user_id") @db.Uuid
  body        String   @db.Text
  pinned      Boolean  @default(false)
  clientId    String?  @map("client_id")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  lead  Lead @relation(fields: [leadId], references: [id], onDelete: Cascade)
  actor User @relation(fields: [actorUserId], references: [id])

  @@unique([leadId, clientId])
  @@index([leadId])
  @@map("notes")
}

model Assessment {
  id                 String           @id @default(uuid()) @db.Uuid
  leadId             String           @map("lead_id") @db.Uuid
  createdByUserId    String           @map("created_by_user_id") @db.Uuid
  mode               AssessmentMode   @default(IN_PERSON)
  magicLinkToken     String?          @unique @map("magic_link_token")
  magicLinkExpiresAt DateTime?        @map("magic_link_expires_at")
  status             AssessmentStatus @default(NOT_STARTED)
  startedAt          DateTime?        @map("started_at")
  completedAt        DateTime?        @map("completed_at")
  respondentName     String?          @map("respondent_name")
  respondentEmail    String?          @map("respondent_email")
  createdAt          DateTime         @default(now()) @map("created_at")

  lead      Lead               @relation(fields: [leadId], references: [id], onDelete: Cascade)
  createdBy User               @relation(fields: [createdByUserId], references: [id])
  answers   AssessmentAnswer[]

  @@index([leadId])
  @@map("assessments")
}

model AssessmentAnswer {
  id           String @id @default(uuid()) @db.Uuid
  assessmentId String @map("assessment_id") @db.Uuid
  questionId   String @map("question_id")
  answerValue  Json   @map("answer_value")

  assessment Assessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)

  @@unique([assessmentId, questionId])
  @@map("assessment_answers")
}

model ServiceMatch {
  id          String      @id @default(uuid()) @db.Uuid
  leadId      String      @map("lead_id") @db.Uuid
  serviceLine ServiceLine @map("service_line")
  fitScore    Int         @map("fit_score")
  reasoning   String      @db.Text
  recommended Boolean     @default(false)

  lead Lead @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@unique([leadId, serviceLine])
  @@map("service_matches")
}

model ResearchArtifact {
  id        String               @id @default(uuid()) @db.Uuid
  leadId    String               @map("lead_id") @db.Uuid
  type      ResearchArtifactType
  payload   Json
  sourceUrl String?              @map("source_url")
  createdAt DateTime             @default(now()) @map("created_at")

  lead Lead @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([leadId])
  @@map("research_artifacts")
}

model Handoff {
  id              String        @id @default(uuid()) @db.Uuid
  leadId          String        @map("lead_id") @db.Uuid
  initiatorUserId String        @map("initiator_user_id") @db.Uuid
  acceptorUserId  String?       @map("acceptor_user_id") @db.Uuid
  status          HandoffStatus @default(DRAFT)

  // v2.3 — structured 60-field handoff checklist (replaces freeform `payload`)
  dealValue             Decimal?       @map("deal_value") @db.Decimal(12, 2)
  bundleId              ServiceBundle? @map("bundle_id")
  complianceOverlay     String[]       @default([]) @map("compliance_overlay")
  contractsSigned       String[]       @default([]) @map("contracts_signed")
  decisionMakers        Json           @default("[]") @map("decision_makers") // up to 5 [{ name, role, authority, temperature, comms }]
  hardCommitments       Json           @default("[]") @map("hard_commitments") // [{ text, sowRef, deadline }]
  softCommitments       Json           @default("[]") @map("soft_commitments")
  objectionsAndSkeptics Json           @default("[]") @map("objections_and_skeptics") // [{ name, concern, status }]
  stakeholderContext    String?        @map("stakeholder_context") @db.Text
  budgetSnapshot        Json?          @map("budget_snapshot") // { status, range, notes }
  successCriteria       Json           @default("[]") @map("success_criteria") // [{ metric, target, owner }]
  // v3.3 — SOP Step 8: stated-pain recap + Day-30 quick win
  statedPain            String?        @map("stated_pain") @db.Text
  day30QuickWin         String?        @map("day30_quick_win") @db.Text

  notes          String?   @db.Text
  initiatedAt    DateTime? @map("initiated_at")
  acceptedAt     DateTime? @map("accepted_at")
  rejectedAt     DateTime? @map("rejected_at")
  rejectedReason String?   @map("rejected_reason") @db.Text
  // v2.20 — cached AI quality-check output: { severity, issues[], suggestions[], generatedAt }
  qcResult       Json?     @map("qc_result")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  lead      Lead  @relation(fields: [leadId], references: [id], onDelete: Cascade)
  initiator User  @relation("HandoffInitiator", fields: [initiatorUserId], references: [id])
  acceptor  User? @relation("HandoffAcceptor", fields: [acceptorUserId], references: [id])

  @@index([leadId])
  @@map("handoffs")
}

// v2.20 — every Claude call writes one row. Drives org + per-lead budget
// enforcement and surfaces month-to-date spend on /admin/ai-usage.
model AiUsageLog {
  id                       String        @id @default(uuid()) @db.Uuid
  leadId                   String?       @map("lead_id") @db.Uuid
  userId                   String?       @map("user_id") @db.Uuid
  feature                  AiFeatureKind
  model                    String
  inputTokens              Int           @map("input_tokens")
  outputTokens             Int           @map("output_tokens")
  cacheReadInputTokens     Int?          @map("cache_read_input_tokens")
  cacheCreationInputTokens Int?          @map("cache_creation_input_tokens")
  estimatedCostUsd         Decimal       @map("estimated_cost_usd") @db.Decimal(10, 6)
  createdAt                DateTime      @default(now()) @map("created_at")

  lead Lead? @relation(fields: [leadId], references: [id], onDelete: SetNull)
