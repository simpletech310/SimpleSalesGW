  kickoff              Kickoff?

  @@index([status])
  @@index([accountManagerId])
  @@map("customers")
}

model DiscoveryAssessment {
  id                   String          @id @default(uuid()) @db.Uuid
  // v2.17 — customerId nullable so the same model handles pre-sale
  // (on Lead) and post-sale (on Customer). Auto-migrates from
  // lead-only → both-set when the handoff is accepted; leadId stays
  // for traceability. App-level invariant: at least one must be set.
  customerId           String?         @map("customer_id") @db.Uuid
  leadId               String?         @map("lead_id") @db.Uuid
  kind                 DiscoveryKind
  status               DiscoveryStatus @default(NOT_STARTED)
  startedAt            DateTime?       @map("started_at")
  completedAt          DateTime?       @map("completed_at")
  createdByUserId      String          @map("created_by_user_id") @db.Uuid
  answers              Json            @default("{}")
  scorecard            Json?
  // v2.23 — vCIO elevation: cached AI plan snapshot + acceptance audit.
  // aiPlanSnapshot is the most-recent AI output (regenerate-safe).
  // planAcceptedSnapshot is the frozen copy of what was actually accepted
  // — preserved even if the vCIO regenerates the plan later, so the
  // materialized OnboardingTasks always have a traceable source.
  aiPlanSnapshot       Json?           @map("ai_plan_snapshot")
  aiPlanGeneratedAt    DateTime?       @map("ai_plan_generated_at")
  planAcceptedAt       DateTime?       @map("plan_accepted_at")
  planAcceptedByUserId String?         @map("plan_accepted_by_user_id") @db.Uuid
  planAcceptedSnapshot Json?           @map("plan_accepted_snapshot")
  // v3.3 — SOP Step 5: vCIO go/no-go gate
  vcioVerdict          ReviewVerdict?  @map("vcio_verdict")
  vcioVerdictAt        DateTime?       @map("vcio_verdict_at")
  vcioVerdictById      String?         @map("vcio_verdict_by_id") @db.Uuid
  vcioVerdictNotes     String?         @map("vcio_verdict_notes") @db.Text
  createdAt            DateTime        @default(now()) @map("created_at")
  updatedAt            DateTime        @updatedAt @map("updated_at")

  customer       Customer? @relation(fields: [customerId], references: [id], onDelete: Cascade)
  lead           Lead?     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  createdBy      User      @relation("DiscoveryCreator", fields: [createdByUserId], references: [id])
  planAcceptedBy User?     @relation("PlanAccepter", fields: [planAcceptedByUserId], references: [id])
  vcioVerdictBy  User?     @relation("AssessmentVcioVerdict", fields: [vcioVerdictById], references: [id])

  @@index([customerId, kind])
  @@index([leadId, kind])
  @@index([vcioVerdict])
  @@map("discovery_assessments")
}

model OnboardingTask {
