model Attachment {
  id               String   @id @default(uuid()) @db.Uuid
  // v2.23 — leadId is now nullable to support polymorphic ownership.
  // EXACTLY ONE of (leadId) or (entityType + entityId) must be set,
  // enforced at the API layer.
  leadId           String?  @map("lead_id") @db.Uuid
  // v2.23 — polymorphic owner. entityType is one of:
  //   "FirewallAsset" | "SwitchAsset" | "AccessPoint" | "ServerAsset"
  //   | "StorageAsset" | "NetworkCircuit" | "EndpointSummary"
  //   | "LicenseEntry" | "VendorContract" | "Site"
  //   | "Customer" | "DiscoveryAssessment"
  entityType       String?  @map("entity_type")
  entityId         String?  @map("entity_id") @db.Uuid
  uploadedByUserId String   @map("uploaded_by_user_id") @db.Uuid
  filename         String
  contentType      String   @map("content_type")
  byteSize         Int      @map("byte_size")
  storagePath      String   @map("storage_path")
  publicUrl        String   @map("public_url")
  // v3.3.13 — optional rep-set category so SE/vCIO can scan
  // attachments at a glance (site_photo, business_card, floor_plan, etc.).
  // String not enum so growing the taxonomy doesn't require a migration.
  category         String?
  caption          String?
  createdAt        DateTime @default(now()) @map("created_at")

  lead       Lead? @relation(fields: [leadId], references: [id], onDelete: Cascade)
  uploadedBy User  @relation(fields: [uploadedByUserId], references: [id])

  @@index([leadId])
  @@index([entityType, entityId])
  @@map("attachments")
}

model PricingApproval {
