# ----------------------------------------------------------------------------
# Gateway TelNet Sales Portal — environment variables
# Copy this file to .env.local for local dev (gitignored).
# Never commit real secrets. Rotate any key that has been exposed.
# ----------------------------------------------------------------------------

# Database (local dev uses Docker Postgres on port 5433 to avoid host conflicts)
DATABASE_URL="postgresql://gateway:gateway@localhost:5433/gateway_sales?schema=public"

# NextAuth v5
# Generate: openssl rand -base64 32
AUTH_SECRET="replace-me-with-openssl-rand-base64-32"
AUTH_URL="http://localhost:3000"
# Session lifetime in hours
AUTH_SESSION_MAX_AGE_HOURS="12"

# Resend (email)
# Get from https://resend.com/api-keys
RESEND_API_KEY=""
# Default Resend test domain works without DNS verification
EMAIL_FROM="Gateway TelNet <onboarding@resend.dev>"
EMAIL_REPLY_TO="lin@gatewaytelnet.com"

# Anthropic (research summary + scoring assist)
# Get from https://console.anthropic.com/
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-sonnet-4-6"

# Vercel Blob — auto-injected on Vercel when the Blob store is connected.
# Get manually from https://vercel.com/dashboard/stores
BLOB_READ_WRITE_TOKEN=""

# Self-service assessment link expiry (days)
ASSESSMENT_LINK_EXPIRY_DAYS="14"

# Override the scraper User-Agent identity (optional)
SCRAPE_USER_AGENT=""

# v3.3.28 — free-tier OSINT providers for agentic lead research.
# All optional. Missing keys = the tool gracefully degrades / falls back.
#
# Tavily (https://tavily.com): 1000 free queries/mo, designed for LLM grounding.
TAVILY_API_KEY=""
# Brave Search (https://api.search.brave.com): 2000 free queries/mo, used as
# the fallback when Tavily quota is exhausted or its key is missing.
BRAVE_SEARCH_API_KEY=""
# Hunter.io (https://hunter.io): 25 free email lookups/mo. Falls back to
# regex over already-scraped pages when the quota is hit.
HUNTER_API_KEY=""

# App
NEXT_PUBLIC_APP_NAME="Gateway TelNet Sales Portal"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# v2.22 — Mapbox (geocoding + maps)
# Secret token (sk.…) is server-only (geocoding API + static images).
# Public token (pk.…) is exposed to the client for GL JS map rendering.
# Get from https://account.mapbox.com/access-tokens/ — make sure the
# secret has `geocoding:read` scope at minimum.
MAPBOX_SECRET_TOKEN=""
NEXT_PUBLIC_MAPBOX_PUBLIC_TOKEN=""

# v2.22 — Daily.co (in-portal video/audio calls)
# Server-only; never exposed to the client. Client uses short-lived
# meeting tokens issued by /api/leads/[id]/calls/start.
# Get from https://dashboard.daily.co/developers
DAILY_API_KEY=""
