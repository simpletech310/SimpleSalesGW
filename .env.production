# Production environment defaults — loaded by Next.js on Vercel.
# Vercel-injected vars (DATABASE_URL, BLOB_READ_WRITE_TOKEN) and any values set
# in the Vercel dashboard override these defaults.
#
# IMPORTANT: do NOT add secrets to this file. It is committed to a public repo.
# Set AUTH_SECRET, ANTHROPIC_API_KEY, RESEND_API_KEY in Vercel:
#   Project → Settings → Environment Variables
#
# See README "Deploying to Vercel" for the exact values to paste.

AUTH_SESSION_MAX_AGE_HOURS="12"

EMAIL_FROM="Gateway TelNet <onboarding@resend.dev>"
EMAIL_REPLY_TO="lin@gatewaytelnet.com"

ANTHROPIC_MODEL="claude-sonnet-4-6"

NEXT_PUBLIC_APP_NAME="Gateway TelNet Sales Portal"
ASSESSMENT_LINK_EXPIRY_DAYS="14"

# AUTH_URL and NEXT_PUBLIC_APP_URL are derived from VERCEL_URL at runtime
# (see src/lib/env.ts). No need to set them.
